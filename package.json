{
  "name": "task-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/server.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "setup": "tsx --env-file-if-exists=.env src/cli.ts setup",
    "backup": "tsx --env-file-if-exists=.env src/cli.ts backup",
    "restore": "tsx --env-file-if-exists=.env src/cli.ts restore",
    "migrate": "tsx --env-file-if-exists=.env src/cli.ts migrate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.0",
    "luxon": "^3.7.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "web-push": "^3.6.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@playwright/test": "^1.55.0",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.35.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.5"
  }
}
