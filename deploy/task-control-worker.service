[Unit]
Description=task-control notification and sync worker
After=network.target

[Service]
Type=simple
User=task-control
Group=task-control
WorkingDirectory=/opt/task-control
EnvironmentFile=/opt/task-control/.env
ExecStart=/usr/bin/npm run worker
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/task-control/data /opt/task-control/backups

[Install]
WantedBy=multi-user.target
